# The bot reads one file per profile:
#   .env.development  (copy .env.development.example)  - Windows localhost dev server
#   .env.production   (copy .env.production.example)   - production server
# Select the profile with --profile development|production (default: development).
# Every value can also be overridden by an environment variable of the same name,
# except POKEVERSE_PROFILE, which must match the file.
POKEVERSE_PROFILE=development

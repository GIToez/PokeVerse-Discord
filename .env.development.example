# PokeVerse Discord bot - DEVELOPMENT profile (Windows localhost dev server).
# Copy to .env.development (or run configure-discord-dev.bat) and fill in the values.
# Never commit .env.development: it contains the dev bot token.

POKEVERSE_PROFILE=development

# --- Discord: use a SEPARATE development application/bot and a development server ---
# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=paste-the-development-bot-token-here
# Developer Portal > General Information > Application ID (optional, enables checks and the invite link)
DISCORD_APPLICATION_ID=
# Right-click the development server > Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=
# Optional: comma-separated user/role IDs allowed to use /pokeverse.
# When both are empty, members with Manage Server can use it.
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
# Optional safety net: the production server ID. Development refuses to start in that server.
PRODUCTION_GUILD_ID=

# --- Game bridge (must match config.local.lua of the local game server) ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7199
# Same value as discordBridgeSecret in the game's config.local.lua (16+ characters).
BRIDGE_SECRET=
BRIDGE_REQUEST_TIMEOUT_MS=5000

# --- Chat relay between #game-chat and the in-game public channel ---
CHAT_ENABLED=true
CHAT_MAX_LENGTH=200
CHAT_USER_MESSAGES=5
CHAT_USER_INTERVAL_SECONDS=10
CHAT_GLOBAL_MESSAGES=20
CHAT_GLOBAL_INTERVAL_SECONDS=10
CHAT_MAX_EVENT_AGE_SECONDS=30

# --- Catch announcements: all | rare_only | shiny_legendary_only | off ---
CATCH_MODE=all
# Extra species counted as rare for rare_only (comma-separated, shiny/legendary are always rare)
CATCH_RARE_SPECIES=
CATCH_MAX_EVENT_AGE_SECONDS=600

# --- Spawn alerts ---
SPAWN_SHINY_ENABLED=true
SPAWN_LEGENDARY_ENABLED=true
# none | town | coordinates
SPAWN_LOCATION_MODE=town
# Where a shiny legendary is announced (once): legendary | shiny
SPAWN_SHINY_LEGENDARY_ROUTE=legendary
# Announce shinies placed while the game server starts
SPAWN_ANNOUNCE_STARTUP=false
# Comma-separated subset of: spawn,script,fishing,headbutt (empty = all)
SPAWN_SOURCES=
SPAWN_MAX_EVENT_AGE_SECONDS=300

# --- Announcements and status ---
ANNOUNCE_BROADCASTS=true
ANNOUNCE_RESTART_WARNINGS=true
STATUS_REFRESH_SECONDS=60

# Create missing channels automatically on startup (default: true in development)
AUTO_SETUP=true
# Folder with the game client's Pokedex pictures (<dex>.png), e.g.
# C:\PokeVerse\core\client-legacy\data\images\pictures
POKEMON_ARTWORK_DIR=

DELIVERY_QUEUE_SIZE=500
STATE_FILE=data/state.development.json
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_FILE=logs/bot-development.log

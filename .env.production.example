# PokeVerse Discord bot - PRODUCTION profile (future OVHcloud Linux server).
# Copy to .env.production on the production server only. Never commit it.
# Nothing in this repository deploys or connects to production automatically.

POKEVERSE_PROFILE=production
# Must be "yes": confirms this file is meant for the production bot.
POKEVERSE_CONFIRM_PRODUCTION=

DISCORD_TOKEN=paste-the-production-bot-token-here
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=

# The bot runs on the same machine as the game server; keep the bridge on loopback.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7199
BRIDGE_SECRET=
BRIDGE_REQUEST_TIMEOUT_MS=5000
# Only for a private network or SSH tunnel. Never expose the bridge publicly.
BRIDGE_ALLOW_REMOTE=false

CHAT_ENABLED=true
CHAT_MAX_LENGTH=200
CHAT_USER_MESSAGES=5
CHAT_USER_INTERVAL_SECONDS=10
CHAT_GLOBAL_MESSAGES=20
CHAT_GLOBAL_INTERVAL_SECONDS=10
CHAT_MAX_EVENT_AGE_SECONDS=30

CATCH_MODE=rare_only
CATCH_RARE_SPECIES=
CATCH_MAX_EVENT_AGE_SECONDS=600

SPAWN_SHINY_ENABLED=true
SPAWN_LEGENDARY_ENABLED=true
SPAWN_LOCATION_MODE=town
SPAWN_SHINY_LEGENDARY_ROUTE=legendary
SPAWN_ANNOUNCE_STARTUP=false
SPAWN_SOURCES=
SPAWN_MAX_EVENT_AGE_SECONDS=300

ANNOUNCE_BROADCASTS=true
ANNOUNCE_RESTART_WARNINGS=true
STATUS_REFRESH_SECONDS=60

# --- Private staff activity log (#player-activity in the "Admin Logs" category) ---
# Login/logout embeds with character, level, account number, IP and approximate location.
# The bot posts only while the channel is private (checked before every post).
ACTIVITY_LOG_ENABLED=true
# Who may see it (comma-separated IDs). Both empty = DISCORD_ADMIN_ROLE_IDS/DISCORD_ADMIN_USER_IDS.
ACTIVITY_LOG_VIEWER_ROLE_IDS=
ACTIVITY_LOG_VIEWER_USER_IDS=
# IP address in the private channel: full | masked (first two parts) | hidden
ACTIVITY_LOG_IP=full
# Days to keep activity messages and records (they are deleted afterwards)
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_FILE=data/activity.production.json
# Optional local MaxMind-format database for approximate locations (e.g. GeoLite2-City.mmdb).
# Lookups never leave this machine. Empty = no locations.
GEOIP_DATABASE=

# --- Account linking (/link with a code from !discord link in game) ---
LINKING_ENABLED=true
VERIFIED_ROLE_NAME=Verified Trainer
# Extra role while the game account has premium time
PREMIUM_ROLE_ENABLED=true
PREMIUM_ROLE_NAME=Ace Trainer
# Set the server nickname to the main character (the global username is never changed)
NICKNAME_SYNC=true
# Re-check every link every N minutes (premium expiry, links removed in game); 0 = off
LINK_RESYNC_MINUTES=15
# Restore roles when a linked member rejoins. Needs SERVER MEMBERS INTENT in the Developer Portal.
DISCORD_MEMBERS_INTENT=false

# Production does not create channels on startup unless enabled; use the setup command.
AUTO_SETUP=false
POKEMON_ARTWORK_DIR=

DELIVERY_QUEUE_SIZE=500
STATE_FILE=data/state.production.json
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/bot-production.log
